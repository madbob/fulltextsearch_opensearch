{
	"name": "madbob/fulltextsearch_opensearch",
	"description": "Extension to the _Full Text Search_ app to communicate with OpenSearch.",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Roberto Guido",
			"email": "info@madbob.org",
			"homepage": "https://www.madbob.org/"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\FullTextSearch_OpenSearch\\": "lib/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"require": {
		"php": "^8.4",
		"bamarni/composer-bin-plugin": "^1.8",
		"nyholm/psr7": "^1.8",
		"opensearch-project/opensearch-php": "^2.6",
		"symfony/http-client": "^8.0"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable34",
		"roave/security-advisories": "dev-latest"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true,
			"php-http/discovery": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.4"
		}
	}
}
